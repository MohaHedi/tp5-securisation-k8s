.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "16"
displayName = "TP5 Labo Kubernetes securise"
annotation = "Ubuntu 24.04 + minikube : le labo du TP 5 se monte tout seul au 1er demarrage (20 a 40 min).|0AIdentifiant : eleve|0AMot de passe initial : kubernetes (a changer a la 1re connexion)"
guestOS = "ubuntu-64"
firmware = "bios"
numvcpus = "4"
cpuid.coresPerSocket = "2"
memsize = "8192"
scsi0.present = "TRUE"
scsi0.virtualDev = "pvscsi"
scsi0:0.present = "TRUE"
scsi0:0.fileName = "TP5-Labo-K8s.vmdk"
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "seed-cidata.iso"
ide1:0.startConnected = "TRUE"
ethernet0.present = "TRUE"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "vmxnet3"
ethernet0.addressType = "generated"
ethernet0.startConnected = "TRUE"
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"
vmci0.present = "TRUE"
svga.present = "TRUE"
svga.vramSize = "16777216"
tools.syncTime = "TRUE"
tools.upgrade.policy = "manual"
usb.present = "FALSE"
sound.present = "FALSE"
floppy0.present = "FALSE"
